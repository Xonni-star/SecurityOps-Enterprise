# Kopie nach .env.local anlegen und Werte eintragen.

# Host, auf dem der Backend-Server lauscht (Standard: nur lokal).
API_BACKEND_HOST = "127.0.0.1"

# Port des Backend-Servers.
API_BACKEND_PORT = 5000

# Maximale Größe angenommener Requests.
API_PAYLOAD_MAX_SIZE = "7mb"

# Google Cloud Projekt-Konfiguration.
GOOGLE_CLOUD_LOCATION = "global"
GOOGLE_CLOUD_PROJECT = "dein-projekt-id"

# Zufälliger Proxy-Header (lokal erzeugen, z. B. `openssl rand -hex 16`).
PROXY_HEADER = "bitte-lokal-setzen"
